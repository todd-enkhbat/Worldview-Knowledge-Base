{
  "manifest_version": 3,
  "name": "Worldview Reader",
  "version": "0.11.6",
  "icons": {
    "128": "worldview-128.png"
  },
  "description": "Save chosen profiles, company details, education, affiliations, articles and highlights to your local Worldview workspace.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "worldview-128.png",
    "default_title": "Worldview Reader \u00b7 keep a page or profile"
  },
  "commands": {
    "open-reader-window": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Open Worldview Reader in a window"
    }
  },
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://tally.so/*",
    "https://*.typeform.com/*",
    "https://docs.google.com/*",
    "https://forms.office.com/*"
  ]
}
