{
  "name": "Worldview",
  "short_name": "Worldview",
  "description": "Your local library, writing desk, and living knowledge world.",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["text/*", "application/pdf", ".docx", ".json", ".jsonl", ".md"] }]
    }
  },
  "icons": [
    { "src": "/brand/worldview-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/brand/worldview-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
