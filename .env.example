# Copy to .env.local (gitignored) and fill in. Read by the dev/preview server only;
# it never reaches the browser bundle (no VITE_ prefix).
# Cloud AI is off by default. Retained keys never enable it automatically.
# Opt in later with AI_PROVIDER=openai or AI_PROVIDER=anthropic, then restart.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.2-sol
# OPENAI_REFINE_MODEL=gpt-6.2-sol
# Optional alternative provider:
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# ANTHROPIC_REFINE_MODEL=claude-haiku-5-5
# Private Telegram bot credential and explicit sender/chat allowlists. Enable in Sources.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Local speech assets/decoder (defaults use data/models and the installed FFmpeg).
# WORLDVIEW_MODELS_DIR=/absolute/path/to/worldview-models
# WORLDVIEW_FFMPEG_PATH=/absolute/path/to/ffmpeg
# Optional: isolate a local or QA corpus while retaining the canonical localhost:5173 origin.
# HYPERSPACE_DATA_DIR=/absolute/path/to/worldview-data

# Optional Google Drive connection. Prefer uploading this app's Desktop OAuth
# client JSON in Sources & activity → Google Drive. Credentials stay server-side.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# Advanced embedded web Picker only; Desktop OAuth needs no API key.
# GOOGLE_PICKER_API_KEY=
# GOOGLE_DRIVE_APP_ID=
