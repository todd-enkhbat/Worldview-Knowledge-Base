{
  "name": "architectural-hyperspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A brutalist 4D worldview engine: reversible integer physics, splat dioramas, local-first.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite build && vite preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accept": "node scripts/accept-physics.ts",
    "bench": "node scripts/bench-physics.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
