    "@react-three/postprocessing": "3.2.0",
    "@sparkjsdev/spark": "2.3.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "maath": "0.10.8",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
